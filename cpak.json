{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "vokoscreenNG",
  "description": "Record the desktop, a window or a selected area with audio and camera support.",
  "version": "4.10.0",
  "image": "ghcr.io/containerpak/vokoscreenng@sha256:31bd17e95595df904e66713dad15bcad5a069adcb750fd515cd2cffc4847797c",
  "binaries": [
    "/usr/bin/vokoscreenNG"
  ],
  "desktop_entries": [
    "/usr/share/applications/vokoscreenNG.desktop"
  ],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSshAgent": false,
    "socketCups": false,
    "socketGpgAgent": false,
    "bluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": true,
    "deviceVideo": true,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": true,
    "openURI": true,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": false,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
